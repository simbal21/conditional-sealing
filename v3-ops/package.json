{
  "name": "@cealis/v3-ops",
  "version": "0.1.0",
  "description": "Cealis V3 Operational Ceremonies per docs/specs/operational-ceremonies-spec.md (S2-6). 17 ceremonies (16 catalog rows + §16.5 Phase 2 transition), two distinct multisig actors (CealisSecurityMultisig + EmergencyGovernance), 5 V3 registries, 10 G4 refusal reason codes, 9-class CEREMONY_ERR_* enum, 8 cross-ceremony invariants, App. B 17x8 matrix, App. A 17 timeline diagrams. Cealis-internal only.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "cealis-ops": "./dist/cli/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "default": "./dist/errors/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog/index.d.ts",
      "default": "./dist/catalog/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "runbooks",
    "SPEC-COMPLIANCE-GUARD-M7.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings 0",
    "clean": "rm -rf dist coverage .coverage"
  },
  "dependencies": {
    "@cealis/v3-crypto": "workspace:*",
    "@safe-global/protocol-kit": "5.0.4",
    "@safe-global/types-kit": "1.0.4",
    "viem": "2.21.55",
    "@noble/hashes": "1.8.0",
    "canonicalize": "2.0.0"
  },
  "devDependencies": {
    "@types/node": "22.19.18",
    "@typescript-eslint/eslint-plugin": "8.59.2",
    "@typescript-eslint/parser": "8.59.2",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "9.17.0",
    "prettier": "3.4.2",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
