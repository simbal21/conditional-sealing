# V3 environment template — separate from V1's .env.example.
# DO NOT share secrets, paths, or DKG material between V1 and V3.

# --- Chain ---
CHAIN_ID=84532                 # Base Sepolia for testnet; 8453 for mainnet
CHAIN_RPC_URL=                 # HTTPS RPC endpoint
CHAIN_WSS_URL=                 # WebSocket RPC endpoint

# --- Lit V3 (rented commodity) ---
LIT_NETWORK=                   # e.g. datil-test
LIT_AUTH_HEADER=               # Lit auth credential

# --- G3 (drand or dcipher, per-PDA) ---
DRAND_NETWORK_URL=             # e.g. https://drand.cloudflare.com
DCIPHER_RELAY_URL=             # placeholder; dcipher integrates later

# --- G4 (operator verification) ---
G4_AUTHORITY_KEY_PATH=         # Phase 1: server-held Ed25519; Phase 2: HSM TEE
G4_REASON_CODE_REGISTRY=       # closed enum: 0x01..0x05

# --- Vault ---
VAULT_BACKEND=                 # s3 | r2 | ipfs | filecoin (per PDA)
VAULT_BUCKET=
VAULT_ACCESS_KEY=
VAULT_SECRET_KEY=

# --- DB ---
DATABASE_URL=                  # PostgreSQL DSN

# --- Subject onboarding ---
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=

# --- Observability ---
LOG_LEVEL=info
SENTRY_DSN=
