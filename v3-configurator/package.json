{
  "name": "@cealis/v3-configurator",
  "version": "0.1.0",
  "description": "Cealis V3 configurator + PDA package per docs/specs/configurator-pda-spec.md (S2-4). Five-stage verification gate (syntax / crypto-invariant CI-01..CI-20 / class-table allow-list+bounds / cross-field CF-01..CF-07 / simulation), 103-row Per-Surface Class Table, 5 PDA+ governance sub-classifications, 5 archetype fixtures, CLI surfaces (init/validate/emit/verify/diff). Cealis-internal-only at all phases per §2.3.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "cealis-config": "./dist/cli/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "default": "./dist/errors/index.js"
    },
    "./fixtures": {
      "types": "./dist/fixtures/app-a/index.d.ts",
      "default": "./dist/fixtures/app-a/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "fixtures",
    "SPEC-COMPLIANCE-GUARD-M4.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.fixtures.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings 0",
    "clean": "rm -rf dist coverage .coverage"
  },
  "dependencies": {
    "@cealis/v3-crypto": "workspace:*",
    "@cealis/v3-custody": "workspace:*",
    "@noble/hashes": "1.8.0",
    "@scure/base": "1.2.6",
    "viem": "2.21.55",
    "canonicalize": "2.0.0",
    "commander": "13.1.0"
  },
  "devDependencies": {
    "@types/node": "22.19.18",
    "@typescript-eslint/eslint-plugin": "8.59.2",
    "@typescript-eslint/parser": "8.59.2",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "9.17.0",
    "prettier": "3.4.2",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
