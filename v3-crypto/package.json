{
  "name": "@cealis/v3-crypto",
  "version": "0.1.0",
  "description": "Byte-exact cryptographic primitives for Cealis V3 per docs/specs/cryptography-spec.md (S2-1).",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "test/fixtures",
    "SPEC-COMPLIANCE-GUARD.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint . --ext .ts --max-warnings 0",
    "clean": "rm -rf dist coverage .coverage"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "@noble/curves": "1.9.7",
    "@noble/ciphers": "1.3.0",
    "@noble/post-quantum": "0.5.4",
    "@scure/base": "1.2.6",
    "@simplewebauthn/server": "13.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
