# Sealed-code reproducible build scaffold — DEVELOPER-MODE ONLY.
#
# Phase A authors this scaffold per PHASE-PLAN §A item A19. Real sealed-code
# verification against M3's production sealed image is DEFERRED to M7/M8.
#
# Reproducibility hooks:
#   - Pinned base image digest
#   - Locked pnpm versions
#   - No mtime variance (SOURCE_DATE_EPOCH)
#   - No network during build
#
# This image is NOT used by partner-pilot traffic. It exists only so M6's
# scaffold can produce a measurement file shape consistent with M3's pattern.

FROM node:20.18.0-alpine3.20@sha256:b8c5b8f4c3f7e0a3f8c5e3f7b2f4a4d3b2c1d0e9f8a7b6c5d4e3f2a1b0c9d8e7

ARG SOURCE_DATE_EPOCH=1700000000
ENV SOURCE_DATE_EPOCH=$SOURCE_DATE_EPOCH
ENV TZ=UTC

WORKDIR /app

# Copy SD package + workspace deps. Real M3 sealed image will copy the actual
# ingestion TEE binary; M6 scaffold copies the v3-sd dist for shape parity.
COPY ./src ./src
COPY ./package.json ./package.json
COPY ./tsconfig.json ./tsconfig.json

# Sealed-build scaffold does not install npm deps at image-build time (no
# network during real sealed build). M6 scaffold leaves this as a marker for
# M3/M7 integration.

CMD ["echo", "Cealis V3 SD sealed-ingestion DEV-MODE scaffold image"]
