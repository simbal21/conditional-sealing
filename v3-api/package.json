{
  "name": "@cealis/v3-api",
  "version": "0.1.0",
  "description": "Cealis V3 Ingestion + Delivery API server per docs/specs/ingestion-delivery-api-spec.md (S2-5). 29 OpenAPI operationIds + 18-event webhook taxonomy + RevealArtifactBundle 15-key format + 10-code G4 refusal + 12-axis × 4-tier behavior matrix. Fastify v5 + Drizzle + BullMQ + SimpleWebAuthn. Cealis-internal-only at all phases.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "cealis-api": "./dist/server/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "default": "./dist/errors/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime-index.d.ts",
      "default": "./dist/runtime-index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "SPEC-COMPLIANCE-GUARD-M5.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings 0",
    "clean": "rm -rf dist coverage .coverage",
    "dev": "node --experimental-vm-modules dist/server/bin.js"
  },
  "dependencies": {
    "@cealis/v3-crypto": "workspace:*",
    "@cealis/v3-custody": "workspace:*",
    "@cealis/v3-configurator": "workspace:*",
    "fastify": "5.2.1",
    "@fastify/sensible": "6.0.2",
    "@fastify/cors": "10.0.1",
    "@fastify/rate-limit": "10.2.1",
    "@fastify/swagger": "9.4.1",
    "@fastify/swagger-ui": "5.2.1",
    "@sinclair/typebox": "0.34.13",
    "drizzle-orm": "0.36.4",
    "pg": "8.13.1",
    "postgres": "3.4.5",
    "bullmq": "5.34.1",
    "ioredis": "5.4.1",
    "@simplewebauthn/server": "13.0.0",
    "@noble/hashes": "1.8.0",
    "@noble/curves": "1.9.7",
    "canonicalize": "2.0.0",
    "viem": "2.21.55",
    "pino": "9.5.0",
    "pino-pretty": "13.0.0",
    "dotenv": "16.4.7",
    "yaml": "2.7.0"
  },
  "devDependencies": {
    "@types/node": "22.19.18",
    "@types/pg": "8.11.10",
    "@typescript-eslint/eslint-plugin": "8.59.2",
    "@typescript-eslint/parser": "8.59.2",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "9.17.0",
    "prettier": "3.4.2",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
