{
  "name": "@cealis/v3-demo",
  "version": "0.1.0",
  "description": "Cealis V3 Internal E2E Demo (M8). Wires M0-M7 into a runnable 4-round demonstration: Round 1 escrow happy path, Round 2 shred (absence-of-event), Round 2b G4 mid-flight refusal, Round 3 SD on. Cealis-internal validation only.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "demo": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "SPEC-COMPLIANCE-GUARD-M8.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings 0",
    "clean": "rm -rf dist coverage .coverage",
    "demo": "node dist/cli.js"
  },
  "dependencies": {
    "@cealis/v3-crypto": "workspace:*",
    "@cealis/v3-custody": "workspace:*",
    "@cealis/v3-configurator": "workspace:*",
    "@cealis/v3-api": "workspace:*",
    "@cealis/v3-sd": "workspace:*",
    "@cealis/v3-sd-verify": "workspace:*",
    "@cealis/v3-ops": "workspace:*",
    "@cealis/verify-sdk": "workspace:*",
    "@noble/hashes": "1.8.0",
    "viem": "2.21.55",
    "postgres": "3.4.5",
    "ioredis": "5.4.1",
    "canonicalize": "2.0.0"
  },
  "devDependencies": {
    "@types/node": "22.19.18",
    "@typescript-eslint/eslint-plugin": "8.59.2",
    "@typescript-eslint/parser": "8.59.2",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "9.17.0",
    "prettier": "3.4.2",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
