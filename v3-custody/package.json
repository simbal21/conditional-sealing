{
  "name": "@cealis/v3-custody",
  "version": "0.1.0",
  "description": "Cealis V3 custody-integration SDK per docs/specs/custody-integration-spec.md (S2-3). Gate adapters (G2 Lit V3, G3 dcipher/drand, G4 Phase 1/2), at-commit-block chain reader, combiner SDK. Imports σ verifiers and Shamir combiner from @cealis/v3-crypto (M1 byte-exact).",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./refusal": {
      "types": "./dist/refusal/index.d.ts",
      "default": "./dist/refusal/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "tests/fixtures",
    "SPEC-COMPLIANCE-GUARD-M3.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings 0",
    "clean": "rm -rf dist coverage .coverage"
  },
  "dependencies": {
    "@cealis/v3-crypto": "workspace:*",
    "@noble/hashes": "1.8.0",
    "@noble/curves": "1.9.7",
    "@noble/ciphers": "1.3.0",
    "@noble/post-quantum": "0.5.4",
    "@scure/base": "1.2.6",
    "@simplewebauthn/server": "13.3.0",
    "@lit-protocol/lit-node-client": "7.3.0",
    "@lit-protocol/contracts-sdk": "7.4.0",
    "drand-client": "1.4.2",
    "viem": "2.21.55",
    "canonicalize": "2.0.0",
    "dotenv": "16.4.7"
  },
  "devDependencies": {
    "@types/node": "22.19.18",
    "@typescript-eslint/eslint-plugin": "8.59.2",
    "@typescript-eslint/parser": "8.59.2",
    "@vitest/coverage-v8": "3.2.4",
    "c8": "10.1.3",
    "eslint": "9.17.0",
    "prettier": "3.4.2",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
